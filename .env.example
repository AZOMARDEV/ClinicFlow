# Docker Compose works without a .env file (these are the defaults).
# Copy to .env to override, or to run the backend/frontend outside Docker.

POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic
POSTGRES_DB=clinicflow

# Inside Docker the API uses host "db"; outside Docker use localhost.
DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinicflow
JWT_SECRET=change-me-to-a-long-random-string-32chars-min
JWT_EXPIRES_IN=8h
APP_TIMEZONE=Africa/Casablanca
CORS_ORIGIN=http://localhost:5173
PORT=4000

VITE_API_URL=http://localhost:4000/api
VITE_APP_TIMEZONE=Africa/Casablanca
